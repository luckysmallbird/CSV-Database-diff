<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Database Diff & SQL Sync Report</title>
    <style>
        <%- customCss %>
    </style>
</head>
<body data-old-target="<%= oldVersionName %>" data-new-source="<%= newVersionName %>">

    <h1>Database Migration Diff & SQL Sync</h1>
    <div class="subtitle">比對 Old（舊版）與 New（新版）CSV 資料，勾選差異列即可產生讓舊資料庫同步至新資料庫的 PostgreSQL 語法。</div>
    
    <div class="summary">
        <p>
            <strong>舊版資料夾 (Old Target):</strong> <%= oldVersionName %> &nbsp;|&nbsp; 
            <strong>新版資料夾 (New Source):</strong> <%= newVersionName %> &nbsp;|&nbsp; 
            <strong>產生時間:</strong> <%= date %>
        </p>
        <p>
            <span><strong>異動表格數:</strong> <%= totalChangedTables %> / <%= reports.length %></span>
            <span class="badge-added">+ <%= totalAdded %> 新增</span>
            <span class="badge-removed">- <%= totalRemoved %> 刪除</span>
            <span class="badge-modified">~ <%= totalModified %> 修改</span>
            <span class="badge-identical" title="兩邊資料庫完全相同的筆數，預設折疊於各表格底部"><%= totalIdentical %> 筆相同</span>
        </p>
    </div>

    <% if (reports.length > 0) { %>
        <% 
            const changedReports = reports.filter(r => r.diffs.length > 0);
            const identicalReports = reports.filter(r => r.diffs.length === 0);
        %>
        <div class="toc-container">
            <div class="toc-header-bar">
                <div class="toc-title">
                    <strong>快速跳轉</strong>
                    <span class="toc-summary-text">（有變更 <%= changedReports.length %> 表，完全相同 <%= identicalReports.length %> 表）</span>
                    <% if (identicalReports.length > 0) { %>
                        <button class="btn-toggle-identical-toc" id="btn-toggle-identical-toc" type="button">
                            完全相同表格 (<%= identicalReports.length %>) <span class="toc-arrow">▾</span>
                        </button>
                    <% } %>
                </div>
                <div class="toc-actions">
                    <button class="btn-action" id="btn-toggle-only-checked">只顯示已勾選項目</button>
                    <button class="btn-action" id="btn-select-all-diffs">全選所有變更</button>
                    <button class="btn-action" id="btn-clear-all-diffs">清除所有勾選</button>
                    <button class="btn-action" id="btn-expand-all">全展開</button>
                    <button class="btn-action" id="btn-collapse-all">全縮小</button>
                </div>
            </div>

            <div class="toc-links-section">
                <div class="toc-changed-links">
                    <% changedReports.forEach(function(report) { %>
                        <a class="toc-link" href="#table-<%= report.filename %>">
                            <%= report.filename %> 
                            <span class="toc-badge-count">(<%= report.diffs.length %> 變更)</span>
                        </a>
                    <% }); %>
                </div>

                <% if (identicalReports.length > 0) { %>
                    <div class="toc-identical-links-container" id="toc-identical-links-container" style="display: none;">
                        <% identicalReports.forEach(function(report) { %>
                            <a class="toc-link toc-link-identical" href="#table-<%= report.filename %>">
                                <%= report.filename %>
                                <span class="toc-badge-count">(0 變更)</span>
                            </a>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>

        <% reports.forEach(function(report) { %>
            <div class="table-card <%= report.diffs.length === 0 ? 'table-card-identical' : '' %>" id="table-<%= report.filename %>" data-filename="<%= report.filename %>" data-tablename="<%= report.tableName %>" data-pks="<%= JSON.stringify(report.primaryKeys) %>">
                <div class="table-header" onclick="this.parentElement.classList.toggle('collapsed')">
                    <h2>
                        <svg class="chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5f6368" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                        </svg>
                        <%= report.filename %>
                        <% if (report.primaryKeys && report.primaryKeys.length > 0) { %>
                            <span class="badge-pk" title="Primary Key 依據 schema.sql 自動解析">PK: <%= report.primaryKeys.join(', ') %></span>
                        <% } else { %>
                            <span class="badge-pk badge-no-pk" title="此資料表未設定唯一主鍵。系統採用全欄位比對；刪除時採取安全去重模式（精確只刪除 1 筆重複項，避免整批誤刪）；新增時則插入全部欄位。">No Primary Key</span>
                        <% } %>
                        <% if (report.diffs.length === 0) { %>
                            <span class="badge-identical-tag" title="此資料表兩邊資料庫內容完全一致，無任何差異">兩邊資料庫完全一致</span>
                        <% } %>
                    </h2>
                    <div class="table-header-right" onclick="event.stopPropagation()">
                        <% if (report.diffs.length > 0) { %>
                            <div class="search-box">
                                <input type="text" class="table-search-input" placeholder="過濾關鍵字 (支援模糊搜尋)...">
                                <button class="search-clear-btn" title="清除搜尋">&times;</button>
                            </div>
                            <span class="table-count-label">差異共 <%= report.diffs.length %> 筆</span>
                        <% } %>
                        <div class="table-badges">
                            <% if (report.addedCount > 0) { %><span class="badge-added">+ <%= report.addedCount %> 新增</span><% } %>
                            <% if (report.removedCount > 0) { %><span class="badge-removed">- <%= report.removedCount %> 刪除</span><% } %>
                            <% if (report.modifiedCount > 0) { %><span class="badge-modified">~ <%= report.modifiedCount %> 修改</span><% } %>
                            <span class="badge-identical" title="兩邊資料庫內容完全一致，預設收合於下方"><%= report.identicalCount %> 筆相同</span>
                        </div>
                    </div>
                </div>

                <div class="table-card-body">
                    <% if (report.diffs.length > 0) { %>
                        <div class="card-toolbar">
                            <div class="card-toolbar-left">
                                <span>選取操作：</span>
                                <button class="btn-mini btn-select-table-all">全選變更</button>
                                <% if (report.addedCount > 0) { %><button class="btn-mini btn-select-table-add">只選新增 (+)</button><% } %>
                                <% if (report.modifiedCount > 0) { %><button class="btn-mini btn-select-table-mod">只選修改 (~)</button><% } %>
                                <% if (report.removedCount > 0) { %><button class="btn-mini btn-select-table-rem">只選刪除 (-)</button><% } %>
                                <button class="btn-mini btn-select-table-none">清空</button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="diff-table" data-headers="<%= JSON.stringify(report.headers) %>">
                                <thead>
                                    <tr>
                                        <th class="th-checkbox"><input type="checkbox" class="header-checkbox" title="全選/全不選目前可見變更"></th>
                                        <th width="70">類型</th>
                                        <% report.headers.forEach(function(header) { %>
                                            <th class="<%= (report.primaryKeys && report.primaryKeys.includes(header)) ? 'th-pk' : '' %>">
                                                <%= header %>
                                                <% if (report.primaryKeys && report.primaryKeys.includes(header)) { %>*<% } %>
                                            </th>
                                        <% }); %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% report.diffs.forEach(function(diff) { %>
                                        <% if (diff.type === 'added') { %>
                                            <tr class="row-added" data-diff-type="added" data-row-data="<%= JSON.stringify(diff.data) %>">
                                                <td class="th-checkbox"><input type="checkbox" class="row-checkbox"></td>
                                                <td class="type-icon type-icon-add">+ 新增</td>
                                                <% diff.data.forEach(function(cell) { %>
                                                    <td><%= cell %></td>
                                                <% }); %>
                                            </tr>
                                        <% } else if (diff.type === 'removed') { %>
                                            <tr class="row-removed <%= diff.isDeduplication ? 'row-dedup' : '' %>" data-diff-type="removed" data-row-data="<%= JSON.stringify(diff.data) %>" data-is-dedup="<%= diff.isDeduplication ? 'true' : 'false' %>">
                                                <td class="th-checkbox"><input type="checkbox" class="row-checkbox"></td>
                                                <td class="type-icon type-icon-rem">
                                                    - 刪除
                                                    <% if (diff.isDeduplication) { %>
                                                        <span class="badge-dedup" title="新版保留 1 筆，舊版重複有 <%= diff.oldCount %> 筆，此操作僅安全刪除 1 筆">去重</span>
                                                    <% } %>
                                                </td>
                                                <% diff.data.forEach(function(cell) { %>
                                                    <td><%= cell %></td>
                                                <% }); %>
                                            </tr>
                                        <% } else if (diff.type === 'modified') { %>
                                            <tr class="row-modified" data-diff-type="modified" data-old-data="<%= JSON.stringify(diff.oldData) %>" data-new-data="<%= JSON.stringify(diff.newData) %>" data-changed-indices="<%= JSON.stringify(diff.changedIndices) %>">
                                                <td class="th-checkbox"><input type="checkbox" class="row-checkbox"></td>
                                                <td class="type-icon type-icon-mod">~ 修改</td>
                                                <% report.headers.forEach(function(header, colIdx) { %>
                                                    <% if (diff.changedIndices.includes(colIdx)) { %>
                                                        <td class="diff-cell" title="Old: <%= diff.oldData[colIdx] %> &#10;New: <%= diff.newData[colIdx] %>">
                                                            <span class="diff-old"><%= diff.oldData[colIdx] %></span>
                                                            <span class="diff-new"><%= diff.newData[colIdx] %></span>
                                                        </td>
                                                    <% } else { %>
                                                        <td><%= diff.newData[colIdx] %></td>
                                                    <% } %>
                                                <% }); %>
                                            </tr>
                                        <% } %>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>

                    <% if (report.identicalRows.length > 0) { %>
                        <div class="identical-section">
                            <div class="identical-toggle" onclick="toggleIdentical(this)">
                                <span class="arrow-icon">▶</span>
                                <span>相同資料（<%= report.identicalCount %> 筆）</span>
                            </div>
                            <div class="identical-content">
                                <table class="identical-table">
                                    <thead>
                                        <tr>
                                            <th width="40">狀態</th>
                                            <% report.headers.forEach(function(header) { %>
                                                <th><%= header %></th>
                                            <% }); %>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% report.identicalRows.forEach(function(row) { %>
                                            <tr class="row-identical">
                                                <td style="text-align: center;">=</td>
                                                <% row.forEach(function(cell) { %>
                                                    <td><%= cell %></td>
                                                <% }); %>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="summary">
            <h3>未比對到任何 CSV 檔案。</h3>
        </div>
    <% } %>

    <!-- Sticky Bottom Bar -->
    <div class="sql-bar" id="sql-bar">
        <div class="sql-bar-counter">
            已勾選 <strong id="selected-count">0</strong> 筆差異列
        </div>
        <div class="sql-bar-btns">
            <button class="btn-sql" id="btn-preview-sql">預覽 PostgreSQL 腳本</button>
            <button class="btn-sql-secondary" id="btn-copy-sql">複製 SQL</button>
            <button class="btn-sql-secondary" id="btn-download-sql">下載 .sql</button>
            <button class="btn-sql-secondary" id="btn-export-snapshot" title="將目前的勾選結果凍結儲存為獨立 HTML 檔">另存勾選紀錄 HTML</button>
        </div>
    </div>

    <!-- SQL Preview Modal -->
    <div class="modal-overlay" id="sql-modal">
        <div class="modal-card">
            <div class="modal-header">
                <h3>PostgreSQL 同步腳本預覽 (Old ➔ New)</h3>
                <button class="close-btn" id="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <pre class="sql-output" id="sql-code-block"></pre>
            </div>
            <div class="modal-footer">
                <button class="btn-sql-secondary" id="modal-copy-btn">複製腳本</button>
                <button class="btn-sql" id="modal-download-btn">下載 .sql 檔案</button>
            </div>
        </div>
    </div>

    <div class="toast" id="toast">已複製到剪貼簿</div>

<script>
    <%- clientJs %>
</script>
</body>
</html>